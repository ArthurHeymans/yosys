# A memory cleared by a reset loop: the clear should become a reset of each
# word register, not be folded into the write data of every word.

read_verilog << EOT
module top(input clk, rst, we, input [1:0] idx, input [7:0] d, output [31:0] q);
	reg [7:0] t [0:3];
	integer i;
	always @(posedge clk)
		if (rst)
			for (i = 0; i < 4; i = i + 1)
				t[i] <= 0;
		else if (we)
			t[idx] <= d;
	assign q = {t[3], t[2], t[1], t[0]};
endmodule
EOT

proc
opt
memory -nomap
opt
memory_map
opt
select -assert-count 4 t:$sdffe
select -assert-none t:$dff t:$dffe
design -stash gate

read_verilog << EOT
module top(input clk, rst, we, input [1:0] idx, input [7:0] d, output [31:0] q);
	reg [7:0] t0, t1, t2, t3;
	always @(posedge clk)
		if (rst)
			{t3, t2, t1, t0} <= 0;
		else if (we)
			case (idx)
				0: t0 <= d;
				1: t1 <= d;
				2: t2 <= d;
				3: t3 <= d;
			endcase
	assign q = {t3, t2, t1, t0};
endmodule
EOT
proc
rename top gold
design -stash gold

design -copy-from gold -as gold gold
design -copy-from gate -as gate top
miter -equiv -flatten -make_assert gold gate miter
sat -verify -prove-asserts -set-init-zero -seq 4 miter
