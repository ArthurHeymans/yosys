read_verilog <<EOT
module top(input h, input oe, input d, input [1:0] s, inout p, inout c);
	assign p = h ? 1'b0 : (oe ? d : 1'bz);
	reg r;
	always @*
		case (s)
			2'b00: r = d;
			2'b01: r = 1'b1;
			default: r = 1'bz;
		endcase
	assign c = r;
endmodule
EOT
proc
design -save input

# Without -logic nothing moves: only the directly visible buffer exists.
tribuf
opt_clean
select -assert-count 1 t:$tribuf
select -assert-none w:p %ci1 t:$tribuf %i

# -logic moves both buffers to the pads.
design -load input
tribuf -logic
opt_clean
select -assert-count 2 t:$tribuf
select -assert-count 1 w:p %ci1 t:$tribuf %i
select -assert-count 1 w:c %ci1 t:$tribuf %i

# -formal still converts everything to logic.
design -load input
tribuf -formal
select -assert-none t:$tribuf
